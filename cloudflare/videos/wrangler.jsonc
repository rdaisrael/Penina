{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "penina-videos",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern": "www.penina-hebrew.org/videos/*", "zone_name": "penina-hebrew.org"},
    {"pattern": "video.penina-hebrew.org", "custom_domain": true}
  ],
  "r2_buckets": [{"binding": "VIDEOS", "bucket_name": "penina-video-test"}],
  "observability": {"enabled": false}
}
