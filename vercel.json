{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(lib|tests)/quiz[^/]*$",
      "status": 404
    },
    {
      "src": "^/Penina-Quizzes/gemara-6-intro-retake/questions(?:\\.json)?$",
      "status": 404
    },
    {
      "src": "^/Penina-Quizzes/gemara-6-wl-2/(questions(?:\\.json)?|talmud-page(?:\\.png)?)$",
      "status": 404
    },
    {
      "src": "^/lib/quiz-grading(?:\\.js)?$",
      "status": 404
    },
    {
      "src": "^/tests/quiz-submissions\\.test\\.js$",
      "status": 404
    },
    {
      "handle": "filesystem"
    }
  ],
  "functions": {
    "api/game-scores.js": {
      "includeFiles": "Penina-Quizzes/{gemara-6-wl-2,gemara-6-intro-retake}/{questions.json,talmud-page.png}"
    }
  }
}
